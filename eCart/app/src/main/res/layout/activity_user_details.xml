<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:orientation="vertical"
    tools:context=".ui.User_Details">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_size16"
                android:text="Account Details"
                android:textColor="#222"
                android:textSize="@dimen/text_size22"
                android:textStyle="bold" />

            <!-- Profile Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/user"
                app:civ_border_color="@color/black"
                app:civ_border_width="3dp" />

            <!-- Name & Email -->
            <TextView
                android:id="@+id/FullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hello, John Doe"
                android:textColor="#000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emailId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="john@example.com"
                android:textColor="#666"
                android:textSize="14sp" />

            <!-- User Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="@dimen/margin_size16"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_size20">

                    <!-- Username -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Username"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/userName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="johndoe123"
                            android:textColor="@color/black"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!--password-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Password"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/passwd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="*******"
                            android:textColor="#000"
                            android:textStyle="bold" />
                        <!-- Eye Icon -->
                        <ImageView
                            android:id="@+id/togglePassVisibility"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/hide"
                            android:contentDescription="Toggle Password" />
                    </LinearLayout>

                    <!--phoneNumber-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Phone"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/phoneNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="672467123"
                            android:textColor="#000"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <!--birthDate-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="DOB"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/birthDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="23"
                            android:textColor="#000"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!--bloodGroup-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Blood Group"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/bloodGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="23"
                            android:textColor="#000"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!--AGE-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Age"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="23"
                            android:textColor="#000"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="@dimen/size_140dp"
                            android:layout_height="wrap_content"
                            android:text="Gender"
                            android:textColor="#444"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/gender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="Male"
                            android:textColor="#000"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bank Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_size20">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Virtual Card"
                        android:textColor="#222"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <!-- Card Visual -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_visual"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:layout_marginBottom="16dp">

                        <!-- Replace the background with a gradient via drawable if you like -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="18dp"
                            android:background="@drawable/bg_card_gradient">

                            <!-- Bank name / type -->
                            <TextView
                                android:id="@+id/tv_card_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Elo"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_alignParentStart="true"/>

                            <!-- Chip icon (optional) -->
                            <View
                                android:layout_width="@dimen/size_40dp"
                                android:layout_height="@dimen/size_40dp"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/chip" />

                            <!-- Card number (masked by default) -->
                            <TextView
                                android:id="@+id/tv_card_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="••••  ••••  ••••  1815"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_centerVertical="true"
                                android:layout_centerHorizontal="true"
                                android:letterSpacing="0.12" />

                            <!-- Expiry and currency -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:text="Expiry"
                                        android:textSize="12sp"
                                        android:textColor="#DDDDFF"/>

                                    <TextView
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:id="@+id/tv_expiry"
                                        android:text="03/26"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_currency"
                                    android:layout_marginStart="24dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CNY"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <!-- Details Card (IBAN, copy, reveal) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/margin_size20"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="Card Details"
                            android:textColor="#222"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <!-- Row: Card Number (full) with reveal icon -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Card Number"
                                android:textSize="14sp"
                                android:textColor="#333"/>

                            <TextView
                                android:id="@+id/tv_card_number_full"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9289 7606 5548 1815"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#000"/>

                            <ImageView
                                android:id="@+id/iv_toggle_card"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/hide"
                                android:contentDescription="Toggle card visibility"/>
                        </LinearLayout>

                        <!-- Row: Expiry & Type -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Expiry"
                                android:textSize="14sp"
                                android:textColor="#333"/>
                            <TextView
                                android:id="@+id/tv_expiry_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="03/26"
                                android:textStyle="bold"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Card Type"
                                android:textSize="14sp"
                                android:textColor="#333"/>
                            <TextView
                                android:id="@+id/tv_card_type_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Elo"
                                android:textStyle="bold"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <!-- IBAN row with mask + copy + reveal -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="IBAN"
                                android:textSize="14sp"
                                android:textColor="#333"/>

                            <TextView
                                android:id="@+id/tv_iban"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="YPUX****BR3HAIXL"
                                android:textStyle="bold"
                                android:textSize="14sp"/>

                            <ImageView
                                android:id="@+id/iv_toggle_iban"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/hide"
                                android:contentDescription="Toggle IBAN"/>

                            <ImageView
                                android:id="@+id/iv_copy_iban"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/copy"
                                android:contentDescription="Copy IBAN"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.cardview.widget.CardView>


            <!-- Address Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_size20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Address Details"
                        android:textColor="#222"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="221B Baker Street"
                        android:textColor="#444"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="London"
                        android:textColor="#444"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Greater London"
                        android:textColor="#444"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/country"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="United Kingdom"
                        android:textColor="#444"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/postcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NW1 6XE"
                        android:textColor="#444"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

<!--            logout-->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:layout_marginBottom="@dimen/margin_size20"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                >
                <LinearLayout
                    android:id="@+id/logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/margin_size12"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size20"
                        android:text="Logout"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/exit"
                        android:layout_marginLeft="@dimen/margin_size7"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
