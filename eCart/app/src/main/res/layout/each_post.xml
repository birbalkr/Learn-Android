<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_size6"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/title"
            android:textStyle="bold"
            android:textSize="@dimen/text_size15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_size4"
            android:text="TextView"
            />
        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_size4"
            android:text="TextView"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_size5"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/view"
                />
            <TextView
                android:id="@+id/view"
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/margin_size4"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:text="View"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            >
            <ImageView
                android:layout_width="@dimen/text_size30"
                android:layout_height="@dimen/text_size30"
                android:src="@drawable/like"
                />
            <TextView
                android:id="@+id/like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_size4"
                android:textStyle="bold"
                android:text="TextView"
                />
            <ImageView
                android:layout_width="@dimen/text_size30"
                android:layout_height="@dimen/text_size30"
                android:src="@drawable/dislike"
                />
            <TextView
                android:id="@+id/dislike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_margin="@dimen/margin_size4"
                android:text="TextView"
                />
        </LinearLayout>

    </LinearLayout>


</LinearLayout>